<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.businessmgmt.controller.SaleFormController"
      styleClass="form-container" spacing="12" prefWidth="780" prefHeight="670">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <Label text="New Sales Transaction / Invoice" styleClass="page-title"/>

    <!-- Header Details -->
    <GridPane hgap="15" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="30"/>
        </columnConstraints>

        <!-- Customer -->
        <Label text="Customer *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="customerComboBox" promptText="Select Customer" prefWidth="250"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- Date -->
        <Label text="Sale Date *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <DatePicker fx:id="saleDatePicker" prefWidth="250"
                    GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <!-- Discount Percent -->
        <Label text="Discount (%)" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="discountPercentField" promptText="0.0" text="0.0"
                   GridPane.rowIndex="1" GridPane.columnIndex="1" onKeyReleased="#onDiscountChanged"/>

        <!-- Notes -->
        <Label text="Notes" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="notesField" promptText="Optional sale notes"
                   GridPane.rowIndex="1" GridPane.columnIndex="3"/>
    </GridPane>

    <Separator/>

    <!-- Add Item Toolbar -->
    <Label text="Add Line Items" styleClass="section-title"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="productComboBox" promptText="Select Product" prefWidth="240" onAction="#onProductSelected"/>
        <Label fx:id="availableStockLabel" text="Stock: -" styleClass="card-label" style="-fx-font-weight: bold;"/>
        <TextField fx:id="itemQuantityField" promptText="Qty" prefWidth="80"/>
        <TextField fx:id="itemUnitPriceField" promptText="Unit Price ($)" prefWidth="120"/>
        <Button text="+ Add Item" onAction="#onAddItem" styleClass="primary-btn"/>
    </HBox>

    <!-- Line Items Table -->
    <TableView fx:id="itemsTable" prefHeight="220" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colItemProduct" text="Product" prefWidth="240"/>
            <TableColumn fx:id="colItemQuantity" text="Quantity" prefWidth="100"/>
            <TableColumn fx:id="colItemUnitPrice" text="Unit Price" prefWidth="120"/>
            <TableColumn fx:id="colItemTotalPrice" text="Total Price" prefWidth="140"/>
            <TableColumn fx:id="colItemAction" text="Action" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Totals Row -->
    <HBox alignment="CENTER_RIGHT" spacing="25">
        <VBox alignment="CENTER_RIGHT" spacing="4">
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label text="Subtotal:" styleClass="form-label"/>
                <Label fx:id="subtotalLabel" text="\$0.00" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label text="Discount Amount:" styleClass="form-label"/>
                <Label fx:id="discountAmountLabel" text="\$0.00" style="-fx-font-size: 14px; -fx-text-fill: #e74c3c;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label text="Total Payable:" styleClass="form-label"/>
                <Label fx:id="totalAmountLabel" text="\$0.00" styleClass="card-value" style="-fx-font-size: 18px;"/>
            </HBox>
        </VBox>
    </HBox>

    <!-- Action Buttons -->
    <HBox styleClass="form-buttons" spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelBtn" text="Cancel" onAction="#onCancel" styleClass="danger-btn"/>
        <Button fx:id="saveBtn" text="Complete Sale" onAction="#onSave" styleClass="success-btn"/>
    </HBox>

</VBox>

